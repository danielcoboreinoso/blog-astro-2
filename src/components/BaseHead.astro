---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/blog-placeholder-1.jpg';
import { AUTHOR_GITHUB, AUTHOR_NAME, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { Font } from 'astro:assets';
import JsonLd from './JsonLd.astro';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	type?: 'website' | 'article';
	publishedTime?: Date;
	updatedTime?: Date;
	author?: string;
	imageAlt?: string;
	profile?: boolean;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const {
	title,
	description,
	image = FallbackImage,
	type = 'website',
	publishedTime,
	updatedTime,
	author = AUTHOR_NAME,
	imageAlt = '',
	profile = false,
} = Astro.props;

const siteURL = new URL(`${base}/`, Astro.site);
const blogURL = new URL(`${base}/blog/`, Astro.site);
const imageURL = new URL(image.src, Astro.site);

// Datos estructurados: un único @graph con las entidades compartidas y,
// en artículos, el BlogPosting y su ruta de navegación.
const personId = `${siteURL.href}#person`;
const websiteId = `${siteURL.href}#website`;
const webpageId = `${canonicalURL.href}#webpage`;

const person = {
	'@type': 'Person',
	'@id': personId,
	name: author,
	url: new URL(`${base}/about/`, Astro.site).href,
	sameAs: [AUTHOR_GITHUB],
};

const website = {
	'@type': 'WebSite',
	'@id': websiteId,
	url: siteURL.href,
	name: SITE_TITLE,
	description: SITE_DESCRIPTION,
	publisher: { '@id': personId },
	inLanguage: 'es',
};

const webpage: Record<string, unknown> = {
	'@type': profile ? 'ProfilePage' : 'WebPage',
	'@id': webpageId,
	url: canonicalURL.href,
	name: title,
	description,
	isPartOf: { '@id': websiteId },
	inLanguage: 'es',
};

if (profile) {
	webpage.mainEntity = { '@id': personId };
}

const graph: Record<string, unknown>[] = [website, webpage, person];

if (type === 'article') {
	graph.push(
		{
			'@type': 'BlogPosting',
			'@id': `${canonicalURL.href}#article`,
			mainEntityOfPage: { '@id': webpageId },
			headline: title,
			description,
			image: imageURL.href,
			datePublished: publishedTime?.toISOString(),
			dateModified: (updatedTime ?? publishedTime)?.toISOString(),
			author: { '@id': personId },
			publisher: { '@id': personId },
			inLanguage: 'es',
		},
		{
			'@type': 'BreadcrumbList',
			'@id': `${canonicalURL.href}#breadcrumb`,
			itemListElement: [
				{ '@type': 'ListItem', position: 1, name: 'Inicio', item: siteURL.href },
				{ '@type': 'ListItem', position: 2, name: 'Blog', item: blogURL.href },
				{ '@type': 'ListItem', position: 3, name: title },
			],
		},
	);
}

const schema = {
	'@context': 'https://schema.org',
	'@graph': graph,
};
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="theme-color" content="#0b1020" />
<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
<link rel="icon" href={`${base}/favicon.ico`} />
<link rel="sitemap" href={`${base}/sitemap-index.xml`} />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL(`${base}/rss.xml`, Astro.site)}
/>
<meta name="generator" content={Astro.generator} />
<meta name="google-site-verification" content="23YqlDjn8PfVIBQ9zodC8J76h9U-sAqlfjuvc5fJ5Dw" />

<Font cssVariable="--font-manrope" preload />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={author} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:url" content={canonicalURL.href} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta property="og:image:alt" content={imageAlt} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />
<meta name="twitter:image:alt" content={imageAlt} />

<!-- Open Graph article metadata -->
{publishedTime ? <meta property="article:published_time" content={publishedTime.toISOString()} /> : null}
{updatedTime ? <meta property="article:modified_time" content={updatedTime.toISOString()} /> : null}

<!-- Datos estructurados (JSON-LD) -->
<JsonLd {schema} />
